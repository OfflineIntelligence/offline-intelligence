#####################################################
# GPU Configuration - HARDCODED
#####################################################
GPU_LAYERS=28
CTX_SIZE=auto
BATCH_SIZE=auto
THREADS=6
PARALLEL_SLOTS=8
UBATCH_SIZE=1024

#####################################################
# Model & Server Paths
#####################################################
MODEL_PATH="C:/Users/pamar/Downloads/qwen2.5-coder-3b-instruct-q4_k_m.gguf"
LLAMA_BIN="C:/Users/pamar/AppData/Roaming/Aud.io/engines/llama-cuda-windows-x64-b8037/llama-server.exe"

#####################################################
# Network Configuration
#####################################################
API_HOST=127.0.0.1
API_PORT=9999
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081

#####################################################
# Performance & Timeout Settings
#####################################################
MAX_CONCURRENT_STREAMS=8
HOT_SWAP_GRACE_SECONDS=25
HEALTH_TIMEOUT_SECONDS=600
HEALTH_CHECK_TIMEOUT_SECONDS=900
GENERATE_TIMEOUT_SECONDS=300
STREAM_TIMEOUT_SECONDS=600


#####################################################
# Monitoring & Logging
#####################################################
PROMETHEUS_PORT=9000
REQUESTS_PER_SECOND=100
RUST_LOG=info,axum=info,tower_http=info

MMPROJ_PATH=none
ENABLE_MULTIMODAL=false
USE_CLIP=false

#####################################################
# Speculative Decoding (Phase 4)
# Set DRAFT_MODEL_PATH to a smaller model (e.g. 0.5B) to enable.
# The draft model must be the same architecture family as the main model.
# VRAM budget: main(~1800MB) + draft(~400MB) + KV(~256MB) = ~2456MB (fits 4GB)
#####################################################
DRAFT_MODEL_PATH=C:/Users/pamar/Downloads/qwen2.5-coder-0.5b-instruct-q4_k_m.gguf
SPECULATIVE_DRAFT_MAX=8
SPECULATIVE_DRAFT_P_MIN=0.4