impl Drop for MemoryDatabase {
    fn drop(&mut self) {
        // Perform a final checkpoint on shutdown
        if let Ok(conn) = self.pool.get() {
            let _ = conn.execute_batch("PRAGMA wal_checkpoint(TRUNCATE);");
        }
    }
}